{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenCoven Chat",
  "version": "0.1.0",
  "identifier": "ai.opencoven.chat",
  "build": {
    "beforeDevCommand": "corepack pnpm dev -- --host 127.0.0.1 --port 4173 --strictPort",
    "beforeBuildCommand": "corepack pnpm build",
    "devUrl": "http://127.0.0.1:4173/",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "OpenCoven Chat",
        "width": 1180,
        "height": 780,
        "minWidth": 820,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost; font-src 'self' data:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
