{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Coven Chat",
  "version": "0.1.1",
  "identifier": "ai.opencoven.chat",
  "build": {
    "beforeDevCommand": "corepack pnpm dev -- --host 127.0.0.1 --port 4173 --strictPort",
    "beforeBuildCommand": "corepack pnpm build",
    "devUrl": "http://127.0.0.1:4173/",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Coven Chat",
        "width": 1180,
        "height": 780,
        "minWidth": 480,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false,
        "generalAutofillEnabled": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost; font-src 'self' data:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "msi",
      "nsis",
      "appimage",
      "deb"
    ],
    "createUpdaterArtifacts": false,
    "publisher": "OpenCoven",
    "copyright": "Copyright (c) 2026 OpenCoven",
    "category": "public.app-category.social-networking",
    "shortDescription": "Desktop chat client for OpenCoven familiars.",
    "longDescription": "Coven Chat brings your local Coven CLI sessions and familiars into one desktop conversation interface.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "infoPlist": "Info.plist"
    },
    "linux": {
      "deb": {
        "depends": [],
        "provides": [
          "opencoven-chat"
        ],
        "conflicts": [
          "opencoven-chat"
        ],
        "replaces": [
          "opencoven-chat"
        ]
      }
    },
    "windows": {
      "wix": {
        "upgradeCode": "a2a06b97-15fc-5a57-98c4-22c77ca45ea2"
      },
      "nsis": {
        "template": "installer/installer.nsi"
      }
    }
  }
}
