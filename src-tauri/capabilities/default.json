{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the OpenCoven Chat main window.",
  "windows": ["main"],
  "permissions": [
    "allow-app-identity",
    "allow-sdk-installation-identity",
    "allow-sdk-authority-discover",
    "allow-sdk-authority-open",
    "allow-sdk-authority-close",
    "allow-cave-health",
    "allow-cave-pairing-create",
    "allow-cave-pairing-poll",
    "allow-cave-pairing-exchange",
    "allow-cave-pairing-commit",
    "allow-cave-pairing-discard",
    "allow-cave-credential-state",
    "allow-cave-forget-credential",
    "allow-cave-list-familiars",
    "allow-cave-list-projects",
    "allow-cave-list-conversations",
    "allow-cave-get-conversation",
    "allow-cave-list-conversation-messages",
    "allow-sdk-native-diagnostics"
  ]
}
