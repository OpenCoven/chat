/.worktrees
.artifacts/
# Local renders and other scratch output kept beside the checkout (27 MB of
# portraits on 2026-10-18); nothing under it is source.
/artifacts/
# Trailing slash matches only a directory. Worktrees under .worktrees/ carry
# `node_modules` as a symlink to the primary checkout, which the slash form
# misses, so `git add -A` there commits an 18-byte symlink and CI then fails
# `pnpm install` with ENOTDIR. Match both spellings.
node_modules/
node_modules
dist/
release-staging/
coverage/
playwright-report/
test-results/
src-tauri/target/
src-tauri/gen/*
!src-tauri/gen/schemas/
src-tauri/gen/schemas/*
!src-tauri/gen/schemas/desktop-schema.json
src-tauri/permissions/autogenerated/

.DS_Store

.superpowers/
.copilot/goals.md

*.rlib
/.playwright-mcp

# secrets
.env*
